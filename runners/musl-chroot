#!/data/data/com.termux/files/usr/bin/sh
# musl-chroot — Pragmatic PRoot Container Engine for Linux/musl (Alpine)
# Preserves host Bionic at /bionic, standard Linux FHS at /usr, /bin, /lib

set -e

PREFIX="${PREFIX:-/data/data/com.termux/files/usr}"
CONTAINER_ROOT="${CONTAINER_ROOT:-$HOME/Library/Containers/musl-aarch64}"

if [ ! -d "$CONTAINER_ROOT" ]; then
    echo "musl-chroot: error: container root not found at $CONTAINER_ROOT" >&2
    echo "Tip: Populate with an aarch64 musl rootfs (Alpine Linux)." >&2
    exit 1
fi

# Base PRoot flags
ARGS="--kill-on-exit -0 --link2symlink"

# 1. System emulation & Kernel interfaces
for dev in dev proc sys; do
    [ -d "/$dev" ] && ARGS="$ARGS -b /$dev:/$dev"
done

# Android Apex & Linker access
[ -d "/apex" ] && ARGS="$ARGS -b /apex:/apex"
[ -e "/linkerconfig/ld.config.txt" ] && ARGS="$ARGS -b /linkerconfig/ld.config.txt:/linkerconfig/ld.config.txt"

# 2. Host Bionic Rescue Mount (Keeps Termux native tools reachable)
ARGS="$ARGS -b $PREFIX:/bionic"

# 3. Mount Foreign FHS from Container Root
ARGS="$ARGS -r $CONTAINER_ROOT"

# 4. Workspace & Persistent User Home Mount
ARGS="$ARGS -b $HOME:/home"
ARGS="$ARGS --cwd=/home"

export HOME=/home
export PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin:/bionic/bin
export TERM="${TERM:-xterm-256color}"
export LANG="C.UTF-8"

if [ -z "$1" ]; then
    exec $PREFIX/bin/proot $ARGS /bin/sh -l
else
    exec $PREFIX/bin/proot $ARGS /bin/sh -c "$*"
fi
