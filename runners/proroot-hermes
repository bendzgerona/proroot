#!/data/data/com.termux/files/usr/bin/bash
set -e

PROROOT="$HOME/Library/Runners/proroot/libproroot.so"
ROOTFS="$HOME/Library/Containers/ubuntu-noble"

if [ ! -f "$PROROOT" ]; then
    echo "Error: proroot binary not found at $PROROOT" >&2
    exit 1
fi

if [ ! -d "$ROOTFS" ]; then
    echo "Error: container rootfs not found at $ROOTFS" >&2
    exit 1
fi

mkdir -p "$ROOTFS/root/.hermes"

exec "$PROROOT" -r "$ROOTFS" -0 --link2symlink \
    -b "$HOME/.hermes:/root/.hermes" \
    -b "$PREFIX:/bionic" \
    -w /root/.hermes \
    /bin/sh -c "export PATH=/opt/hermes-venv/bin:\$PATH; export SSL_CERT_FILE=/etc/ssl/certs/ca-certificates.crt; cd /root/.hermes && exec /opt/hermes-venv/bin/hermes \"\$@\"" -- "$@"
